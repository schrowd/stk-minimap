# Maintainer: schrowd
pkgname=stk-viewer
pkgver=1.6.1
pkgrel=1
pkgdesc="Render SuperTuxKart track minimaps to PNG and play replays back over them"
arch=('any')
url="https://github.com/schrowd/stk-viewer"
license=('GPL-3.0-only')
depends=('python' 'python-pillow' 'tk')
optdepends=('python-numpy: alpha-correct, sharper downscaling')
source=("$pkgname-$pkgver.tar.gz::https://github.com/schrowd/stk-viewer/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('6efb71a8793f6180764900b64bcc33b7d1b0d0fac98c1e99af1a6afb607fe5fa')

# Not on PyPI and deliberately so (see README) - this installs the package
# tree straight into /usr/share rather than building a wheel, and points a
# thin wrapper at it via PYTHONPATH. The C++ patches under patches/ (an
# optional, separate build of SuperTuxKart itself) are not part of this
# package; see the upstream README for those.

package() {
    cd "$pkgname-$pkgver"

    install -d "$pkgdir/usr/share/$pkgname"
    cp -r stk_viewer "$pkgdir/usr/share/$pkgname/"

    install -Dm755 /dev/stdin "$pkgdir/usr/bin/$pkgname" <<'EOF'
#!/bin/sh
exec env PYTHONPATH="/usr/share/stk-viewer${PYTHONPATH:+:$PYTHONPATH}" \
    python3 -m stk_viewer "$@"
EOF

    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$pkgname.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=STK Viewer
GenericName=Minimap renderer
Comment=$pkgdesc
Exec=$pkgname --gui
Icon=applications-graphics
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
Keywords=supertuxkart;stk;minimap;track;speedrun;
EOF

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
