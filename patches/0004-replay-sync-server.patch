+
+#ifndef HEADER_REPLAY_SYNC_SERVER_HPP
+#define HEADER_REPLAY_SYNC_SERVER_HPP
+
+#include <atomic>
+#include <string>
+#include <thread>
+#include <vector>
+
+/**
+  * \brief Lets an external viewer drive replay playback, and follow it.
+  *
+  * A line-based text protocol over a loopback TCP socket.  In:
+  * PLAY / PAUSE / SEEK <s> / RATE <x> / PING.  Out: HELLO, REPLAY, DURATION,
+  * STATE <time> <playing> <rate>, BYE.  Unknown verbs are ignored so either
+  * end can be extended without a version handshake.
+  *
+  * Everything happens on its own thread and talks only to ReplayControl,
+  * which is already thread-safe - the game's main loop is never touched, so
+  * a stalled or vanished client cannot affect the frame rate.
+  *
+  * Only started when --sync-port is given, and only ever binds 127.0.0.1:
+  * this is a control channel into a running game and has no business being
+  * reachable from off the machine.
+  *
+  * \ingroup replay
+  */
+class ReplaySyncServer
+{
+private:
+    static ReplaySyncServer *m_sync_server;
+
+    /** Native socket handle; int everywhere except Windows, where it is
+     *  SOCKET (an unsigned pointer-sized handle).  Kept as intptr_t so the
+     *  header needs no platform includes. */
+    typedef intptr_t socket_handle;
+
+    struct Client
+    {
