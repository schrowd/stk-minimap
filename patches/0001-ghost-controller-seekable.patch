             m_node->setVisible(true);
         }
     }
+    else if (!m_node->isVisible())
+    {
+        // Reaching the end of a replay hides the kart above, and when only
+        // watching a replay nothing ever showed it again - harmless while
+        // playback is strictly forward, but scrubbing back from the end has
+        // to bring it back.  The engine sound and the GFX lights are driven
+        // every frame from updateSound()/updateGraphics(), so they recover
+        // on their own; only the node itself is latched.
+        m_node->setVisible(true);
+    }
 
