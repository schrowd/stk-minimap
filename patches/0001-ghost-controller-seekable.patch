diff --git a/src/karts/controller/ghost_controller.cpp b/src/karts/controller/ghost_controller.cpp
index 0d8c6ad..2234bde 100644
--- a/src/karts/controller/ghost_controller.cpp
+++ b/src/karts/controller/ghost_controller.cpp
@@ -38,6 +38,20 @@ void GhostController::reset()
 void GhostController::update(int ticks)
 {
     m_current_time = World::getWorld()->getTime();
+
+    // The world clock can move backwards when a replay is being scrubbed
+    // (see WorldStatus::setTime), so the index has to be able to follow it
+    // in both directions.  During ordinary forward playback this loop never
+    // executes: after the forward search below, m_all_times[m_current_index]
+    // is always <= m_current_time, and the next frame's time is larger
+    // still.  It is deliberately outside the m_current_time != 0 guard, so
+    // that seeking back to the very start of the replay also works.
+    while (m_current_index > 0 &&
+           m_current_time < m_all_times[m_current_index])
+    {
+        m_current_index--;
+    }
+
     // Find (if necessary) the next index to use
     if (m_current_time != 0.0f)
     {
