+//  but WITHOUT ANY WARRANTY; without even the implied warranty of
+//  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+//  GNU General Public License for more details.
+//
+//  You should have received a copy of the GNU General Public License
+//  along with this program; if not, write to the Free Software
+//  Foundation, Inc., 59 Temple Place - Suite 330, Boston, MA  02111-1307, USA.
+
+#include "replay/replay_control.hpp"
+
+ReplayControl *ReplayControl::m_replay_control = NULL;
+
+//-----------------------------------------------------------------------------
+ReplayControl::ReplayControl()
+{
+    m_enabled  = false;
+    m_playing  = true;
+    m_rate     = 1.0;
+    m_time     = 0.0;
+    m_duration = 0.0;
+    m_dirty    = false;
+}   // ReplayControl
+
+//-----------------------------------------------------------------------------
+/** Resets to the start, playing at normal speed.  Called when a new replay
+ *  world is set up so a second viewing doesn't inherit the first one's
+ *  paused/scrubbed state.
+ */
+void ReplayControl::reset()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_playing  = true;
+    m_rate     = 1.0;
+    m_time     = 0.0;
+    m_duration = 0.0;
+    m_dirty    = true;
+}   // reset
+
+//-----------------------------------------------------------------------------
+/** Advances the playback head.  With the default state (playing, rate 1) this
+ *  counts up exactly as the stock clock does, so switching the feature on
+ *  without touching anything changes nothing.
+ *  \param dt Real time for one tick, in seconds.
+ */
+double ReplayControl::advance(double dt)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_playing)
+    {
+        m_time += dt * m_rate;
+        if (m_time < 0.0)
+            m_time = 0.0;
+        // Hold at the end rather than running past it: the ghosts have no
+        // more data, and letting the clock run on would make the reported
+        // position drift further and further from anything meaningful.
+        if (m_duration > 0.0 && m_time > m_duration)
+        {
+            m_time   = m_duration;
+            m_playing = false;
+        }
+    }
+    return m_time;
+}   // advance
+
+//-----------------------------------------------------------------------------
+void ReplayControl::seek(double t)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (t < 0.0)
+        t = 0.0;
+    if (m_duration > 0.0 && t > m_duration)
+        t = m_duration;
+    m_time  = t;
+    m_dirty = true;
+}   // seek
+
+//-----------------------------------------------------------------------------
+void ReplayControl::setPlaying(bool playing)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    // Starting playback again from the very end would sit there doing
+    // nothing, so treat it as a replay from the top.
+    if (playing && !m_playing && m_duration > 0.0 && m_time >= m_duration)
+        m_time = 0.0;
+    m_playing = playing;
+    m_dirty   = true;
+}   // setPlaying
+
+//-----------------------------------------------------------------------------
+void ReplayControl::setRate(double rate)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    // Guard against a rate of zero (which would look like a pause but leave
+    // the state saying "playing") and against absurd values.
+    if (rate < 0.01) rate = 0.01;
+    if (rate > 16.0) rate = 16.0;
+    m_rate  = rate;
+    m_dirty = true;
+}   // setRate
