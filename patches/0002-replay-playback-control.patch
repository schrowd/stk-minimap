+    // first one, and work out how far it can be scrubbed.
+    if (ReplayControl::get() && ReplayControl::get()->isEnabled())
+    {
+        ReplayControl::get()->reset();
+        if (RaceManager::get()->isWatchingReplay())
+        {
+            // The longest ghost decides the length.  Deliberately the last
+            // *recorded* time rather than the ghost's finish time: the
+            // recording carries on past the finish line, and that tail should
+            // still be reachable when scrubbing.
+            double duration = 0.0;
