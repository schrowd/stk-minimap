--- /dev/null
+++ b/src/replay/replay_control.hpp
@@ -0,0 +1,142 @@
+//
+//  SuperTuxKart - a fun racing game with go-kart
+//  Copyright (C) 2026 SuperTuxKart-Team
+//
+//  This program is free software; you can redistribute it and/or
+//  modify it under the terms of the GNU General Public License
+//  as published by the Free Software Foundation; either version 3
+//  of the License, or (at your option) any later version.
+//
+//  This program is distributed in the hope that it will be useful,
+//  but WITHOUT ANY WARRANTY; without even the implied warranty of
+//  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+//  GNU General Public License for more details.
+//
+//  You should have received a copy of the GNU General Public License
+//  along with this program; if not, write to the Free Software
+//  Foundation, Inc., 59 Temple Place - Suite 330, Boston, MA  02111-1307, USA.
+
+#ifndef HEADER_REPLAY_CONTROL_HPP
+#define HEADER_REPLAY_CONTROL_HPP
+
+#include <atomic>
+#include <mutex>
+
+/**
+  * \brief Playback head for watching a replay: pause, seek and rate.
+  *
+  * Only used when watching a replay (every kart is a GhostKart, so there is
+  * no physics being integrated and a kart's position is a pure function of
+  * the race clock).  This class owns that clock; WorldStatus::updateTime
+  * asks it for the time each tick and publishes the result through
+  * setTime(), so the ghosts, the on-screen timer and everything else that
+  * reads World::getTime() stay on one clock rather than drifting apart.
+  *
+  * Disabled unless explicitly switched on, in which case advance() simply
+  * counts up at rate 1 and the behaviour is the same as the stock clock.
+  *
+  * Commands may arrive from another thread (the sync server), so the mutable
+  * state is behind a mutex; advance() and getTime() are called every tick
+  * from the main thread.
+  *
+  * \ingroup replay
+  */
+class ReplayControl
+{
+private:
+    static ReplayControl *m_replay_control;
+
+    mutable std::mutex m_mutex;
+
+    /** Switched on from the command line; when false nothing here is used. */
+    bool   m_enabled;
+
+    bool   m_playing;
+
+    /** Playback speed, 1.0 is real time. */
+    double m_rate;
+
+    /** The playback head, in seconds. */
+    double m_time;
+
+    /** Length of the loaded replay; 0 when not known, which disables
+     *  clamping at the far end. */
+    double m_duration;
+
+    /** Set when the head is moved, so the sync server can report it
+     *  immediately rather than at the next periodic update. */
+    std::atomic_bool m_dirty;
+
+         ReplayControl();
+        ~ReplayControl() {}
+
+public:
+    static void create()
+    {
+        if (m_replay_control == NULL)
+            m_replay_control = new ReplayControl();
+    }
+    // ------------------------------------------------------------------------
+    static ReplayControl *get()                    { return m_replay_control; }
+    // ------------------------------------------------------------------------
+    static void destroy()
+    {
+        delete m_replay_control;
+        m_replay_control = NULL;
+    }
+    // ------------------------------------------------------------------------
+    /** Advances the head by dt seconds of real time, scaled by the current
+     *  rate and ignored while paused.  Called once per tick from the main
+     *  thread.  Returns the new head. */
+    double advance(double dt);
+    // ------------------------------------------------------------------------
+    /** Moves the head, clamped to the replay.  Safe to call from any
+     *  thread. */
+    void   seek(double t);
+    // ------------------------------------------------------------------------
+    void   setPlaying(bool playing);
+    // ------------------------------------------------------------------------
+    void   setRate(double rate);
+    // ------------------------------------------------------------------------
+    void   reset();
+    // ------------------------------------------------------------------------
+    double getTime() const
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        return m_time;
+    }
+    // ------------------------------------------------------------------------
+    bool   isPlaying() const
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        return m_playing;
+    }
+    // ------------------------------------------------------------------------
+    double getRate() const
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        return m_rate;
+    }
+    // ------------------------------------------------------------------------
+    double getDuration() const
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        return m_duration;
+    }
+    // ------------------------------------------------------------------------
+    void   setDuration(double d)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_duration = d > 0.0 ? d : 0.0;
+    }
+    // ------------------------------------------------------------------------
+    bool   isEnabled() const                            { return m_enabled; }
+    // ------------------------------------------------------------------------
+    void   setEnabled(bool e)                            { m_enabled = e;   }
+    // ------------------------------------------------------------------------
+    /** True if the head moved other than by ordinary playback since the last
+     *  call; clears the flag. */
+    bool   pollDirty()             { return m_dirty.exchange(false); }
+};   // ReplayControl
+
+#endif
