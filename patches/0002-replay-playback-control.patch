+                GhostController *gc =
+                    dynamic_cast<GhostController*>(gk->getController());
+                if (gc != NULL && gc->getLastTime() > duration)
+                    duration = gc->getLastTime();
+            }
+            ReplayControl::get()->setDuration(duration);
+        }
+    }
